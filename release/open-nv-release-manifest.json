{
  "schema": "opennv-release-manifest/v1",
  "product": {
    "name": "Open Nevada",
    "code": "OpenNV",
    "publicDomain": "opennevada.com",
    "technicalDomain": "opennv.org"
  },
  "platforms": {
    "desktopShell": ["windows-x64", "macos-arm64", "linux-x64"],
    "publishedRuntime": []
  },
  "runtime": {
    "engine": "Godot",
    "engineVersion": "4.7.1",
    "repository": "nikamigaming-create/OpenNV",
    "path": "runtime",
    "status": "experimental",
    "playable": false,
    "playableSandbox": true,
    "openxr": {
      "launchable": true,
      "hardwareValidated": false,
      "testedInteractionProfiles": [
        "/interaction_profiles/oculus/touch_controller"
      ]
    }
  },
  "launcher": {
    "repository": "nikamigaming-create/OpenNV",
    "path": "desktop"
  },
  "assetPolicy": {
    "shipBethesdaAssets": false,
    "shipThirdPartyMods": false,
    "shipUserProfilesOrSaves": false,
    "requiresLicensedAssets": true
  },
  "qualityGate": [
    "direct-static-nif-gltf",
    "artifact-provenance",
    "godot-forward-plus-load",
    "desktop-launcher-contract",
    "campaign-chooser",
    "authored-pickup-inventory-loop",
    "persistent-sandbox-cold-reload",
    "openxr-rig-action-map-package-gate",
    "shared-flat-openxr-save-contract"
  ]
}
