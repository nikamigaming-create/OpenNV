<Project Sdk="Godot.NET.Sdk/4.8.0-dev.7">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>OpenNV</AssemblyName>
    <RootNamespace>OpenNV</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-default</AnalysisLevel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools\OpenNV.ResourceProbe\**\*.cs" />
    <Compile Remove="tools\NativeStackStartupAudit\**\*.cs" />
    <Compile Remove="tools\ParityRetailPublisher\**\*.cs" />
    <Compile Remove="tools\ParityLiveComparator\**\*.cs" />
  </ItemGroup>
</Project>
