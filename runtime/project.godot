; OpenNV Godot runtime. Retail-derived generated content is never committed.
config_version=5

[application]

config/name="OpenNV"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false

[xr]

openxr/default_action_map="res://openxr_action_map.tres"
openxr/startup_alert=false
shaders/enabled=true
