{
  "schema": "opennv-nif-decoder-contract/v1",
  "id": "fnv-nif-decoder-v1",
  "status": "owned-format-structural-recovery",
  "provenance": {
    "classification": "clean-room-format-contract",
    "status": "version-bounded",
    "source": "NifTools NiGeometryData schema joined to owned Fallout: New Vegas block boundaries",
    "evidence": "The NifTools schema states that Fallout 3 and Skyrim geometry cannot contain more than one UV set; recovery is accepted only when exactly one configured candidate consumes the complete owned geometry-data block"
  },
  "format": {
    "versionHex": "0x14020007",
    "endian": 1,
    "userVersion": 11,
    "userVersion2": 34,
    "compatibleGeometryUserVersion2": [32],
    "animationUserVersion2": [
      31,
      33
    ],
    "animationRootBlockType": "NiControllerSequence",
    "exportInfoStringCount": 3,
    "footerBytes": 8
  },
  "geometryData": {
    "blockTypes": [
      "NiTriShapeData",
      "NiTriStripsData"
    ],
    "vertexCountOffsetBytes": 4,
    "hasVerticesOffsetBytes": 8,
    "uvCountPrefixBytes": 9,
    "vertexStrideBytes": 12,
    "minimumUvSets": 0,
    "maximumUvSets": 1,
    "recoveryMethod": "unique-exact-block-parse",
    "sourceMutationPolicy": "in-memory-parse-buffer-only"
  }
}
