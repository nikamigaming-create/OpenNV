{
  "schema": "opennv-static-cell-compiler-profile/v2",
  "id": "fnv-static-cell-compiler-v2",
  "archiveRecipe": "fnv-official-actor-archives-v1.json",
  "supportedChildRecordTypes": ["LAND", "REFR"],
  "baseLinkedChildRecordTypes": ["REFR"],
  "supportedBaseRecordTypes": ["ACTI", "CONT", "DOOR", "LIGH", "MSTT", "SCOL", "STAT"],
  "presentationPolicies": {
    "ACTI": {
      "kind": "static-model",
      "modelPathCount": 1,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XSCL"]
    },
    "CONT": {
      "kind": "static-model",
      "modelPathCount": 1,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XSCL"]
    },
    "DOOR": {
      "kind": "static-model",
      "modelPathCount": 1,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XSCL"]
    },
    "LIGH": {
      "kind": "point-light",
      "modelPathCount": 0,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XRDS"]
    },
    "MSTT": {
      "kind": "static-model",
      "modelPathCount": 1,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XSCL"]
    },
    "SCOL": {
      "kind": "static-model",
      "modelPathCount": 1,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XSCL"]
    },
    "STAT": {
      "kind": "static-model",
      "modelPathCount": 1,
      "supportedReferenceSubrecords": ["DATA", "NAME", "XSCL"]
    }
  },
  "childPresentationPolicies": {
    "LAND": {
      "kind": "landscape",
      "supportedChildSubrecords": ["ATXT", "BTXT", "DATA", "VCLR", "VHGT", "VNML", "VTXT"]
    }
  },
  "modelExtension": ".nif",
  "exportStrict": false,
  "compileTextures": true,
  "originPolicy": {
    "interior": "game-origin",
    "exterior": "cell-grid-origin",
    "exteriorCellSizeGameUnits": 4096.0
  },
  "statePolicy": {
    "initiallyDisabled": "blocked",
    "enableParent": "blocked",
    "teleport": "blocked"
  },
  "promotion": {
    "compiledStaticPresentationIsNotRuntimeOrParity": true,
    "anyChildBlockerBlocksCellReadiness": true,
    "anyAssetOrTextureFailureBlocksCellReadiness": true
  }
}
