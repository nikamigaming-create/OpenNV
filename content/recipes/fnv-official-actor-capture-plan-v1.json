{
  "schema": "opennv-actor-capture-plan-recipe/v1",
  "id": "fnv-official-actor-capture-plan-v1",
  "sourceCorpusRecipeId": "fnv-official-actor-parity-corpus-v1",
  "batching": {
    "baseJobsPerBatch": 32
  },
  "observation": {
    "fixedBaseStrategy": "observe-root-once-and-correlate-runtime-signature",
    "dynamicBaseStrategy": "repeat-root-until-every-expected-signature-is-observed",
    "partialCoveragePolicy": "pending-never-pass",
    "framingPolicy": "runtime-render-bounds-and-head-markers",
    "enginesSequential": true,
    "cameraConstantsAllowed": false,
    "requiredTelemetryFields": [
      "official-plugin-stack-sha256",
      "stable-base-form-key",
      "runtime-base-form-id",
      "spawned-reference-form-id",
      "observed-category-source-form-ids",
      "observed-render-part-source-form-ids",
      "runtime-render-bounds",
      "camera-view-projection",
      "animation-state-and-time",
      "equipment-state",
      "native-source-frame-sha256"
    ]
  }
}
